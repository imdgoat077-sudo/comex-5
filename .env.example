OPENAI_API_KEY=your-9router-api-key-here
OPENAI_BASE_URL=http://localhost:20128/v1
MODEL_NAME=ag/gemini-3.8-flash
CDP_URL=http://127.0.0.1:9222
GRAPH_DB_PATH=~/.comex/graph.db

# Internal application token (generate with: openssl rand -hex 32)
# Required for trusted Electron main process <-> agent_service communication.
# Fails closed if missing: do not commit actual tokens to source control.
COMEX_INTERNAL_APP_TOKEN=your-randomly-generated-secret-token-here
